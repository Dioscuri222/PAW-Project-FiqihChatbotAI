  "description": "FiqihAI — Sistem Tanya Jawab Fiqih Kontemporer (PPAW Week 7 - Kelas E, Metode Waterfall)",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "node --watch app.js",
